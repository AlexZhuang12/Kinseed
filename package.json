{
  "name": "kinseed-windows-foundation",
  "version": "1.3.0-preview.1",
  "license": "Apache-2.0",
  "private": true,
  "files": [
    "src/",
    "scripts/",
    "tests/",
    "docs/",
    "config/development.example.json",
    "config/development.schema.json",
    "config/codex.example.json",
    "packages/identity-schema-v2.json",
    ".kinseed-development.json",
    "source-baseline.json",
    "data-boundaries.json",
    "AGENTS.md",
    "啟動開發控制台.cmd",
    "停止開發控制台.cmd",
    "開啟開發控制台.cmd",
    "檢查開發環境.cmd",
    "config/local-model.example.json",
    "首次設定.cmd",
    ".gitattributes",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "SUPPORT.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    ".github/"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "start": "node scripts/development.mjs start",
    "stop": "node scripts/development.mjs stop",
    "status": "node scripts/development.mjs status",
    "open": "node scripts/development.mjs open",
    "check": "node scripts/development.mjs check",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "boundary:check": "node scripts/check-boundaries.mjs",
    "brain:enable": "node scripts/development.mjs enable-codex",
    "brain:disable": "node scripts/development.mjs disable-brain",
    "brain:resources": "node scripts/local-model-readiness.mjs",
    "setup": "node scripts/setup.mjs",
    "source:export": "node scripts/export-source.mjs",
    "release:check": "node scripts/release-check.mjs",
    "backup": "node scripts/maintenance.mjs snapshot",
    "backup:verify": "node scripts/maintenance.mjs verify",
    "ui:build": "node scripts/build-journal-ui.mjs && node scripts/build-owner-controls-ui.mjs && node scripts/build-locales.mjs --complete",
    "ui:check": "node scripts/build-journal-ui.mjs --check && node scripts/build-owner-controls-ui.mjs --check && node scripts/build-locales.mjs --check --complete",
    "test:ui": "node scripts/verify-ui-journey.mjs zh-Hant && node scripts/verify-ui-journey.mjs zh-Hans && node scripts/verify-ui-journey.mjs en && node scripts/verify-ui-journey.mjs ja && node scripts/verify-ui-setup.mjs && node scripts/verify-ui-languages.mjs",
    "acceptance:local": "node scripts/acceptance-run.mjs",
    "acceptance:full": "node scripts/acceptance-run.mjs --allow-provider --allow-install-network",
    "acceptance:provider": "node scripts/acceptance-provider.mjs",
    "acceptance:install": "node scripts/acceptance-install.mjs",
    "acceptance:failure": "node --test tests/delegation.test.mjs tests/deadline-retry.test.mjs tests/brain.test.mjs"
  },
  "dependencies": {
    "ipaddr.js": "2.2.0",
    "playwright-core": "1.62.1",
    "quickjs-emscripten": "0.32.0",
    "unpdf": "1.9.1"
  }
}
